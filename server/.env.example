# ---- Server ----
APP_NAME=IronPilot
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Seed equipment/exercises/templates/admin automatically when the database is empty
AUTO_SEED=true

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/ironpilot

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d
# Google Sign-In: OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# (add http://localhost:5173 and your Vercel URL as authorised JavaScript origins). Same value goes in client VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ---- Email (forgot password / welcome). Leave empty to log emails to the console instead. ----
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IronPilot <no-reply@ironpilot.app>"

# ---- Google Gemini (server-side only, never expose to the client) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Seed admin ----
ADMIN_EMAIL=admin@ironpilot.app
ADMIN_PASSWORD=Admin@12345
