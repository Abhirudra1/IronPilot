# Leave empty in dev to use the Vite proxy. Set for production (e.g. https://fitcoach-api.onrender.com)
VITE_API_URL=
# Dev only: where the Vite proxy forwards /api (default http://localhost:5000)
VITE_PROXY_TARGET=
# Google OAuth Web client ID (same as server GOOGLE_CLIENT_ID). Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=
